{
  "name": "green-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run src --exclude src/integration",
